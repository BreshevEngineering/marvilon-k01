{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k01.technical_filter.schema.json",
  "type": "object",
  "required": [
    "gates"
  ],
  "properties": {
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate",
          "question",
          "status",
          "basis",
          "source_ids",
          "verification_method",
          "evidence_ids",
          "open_actions"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array"
          },
          "verification_method": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array"
          },
          "open_actions": {
            "type": "array"
          }
        }
      }
    }
  }
}