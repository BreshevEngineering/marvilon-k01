{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k01.evidence_provenance.schema.json",
  "type": "object",
  "required": [
    "schema",
    "evidence_id",
    "evidence_path",
    "evidence_sha256",
    "inputs",
    "tool",
    "created"
  ],
  "properties": {
    "schema": {
      "const": "k01.evidence_provenance.v1"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_path": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created": {
      "type": "string"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version",
        "script_sha256"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}