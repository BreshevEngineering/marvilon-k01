{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k01.baseline.schema.json",
  "type": "object",
  "required": [
    "schema",
    "baseline_id",
    "created",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "k01.baseline.v1"
    },
    "baseline_id": {
      "type": "string"
    },
    "created": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "revision_state"
        ]
      }
    }
  }
}